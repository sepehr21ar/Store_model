# Application metadata database. SQLite works locally; use PostgreSQL in production.
DATABASE_URL=sqlite:///./analytics.db
SECRET_KEY=replace-with-a-long-random-production-secret
ACCESS_TOKEN_MINUTES=1440
CORS_ALLOW_ORIGINS=http://localhost:8000
MAX_UPLOAD_MB=25

# AI provider used through LangChain
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
