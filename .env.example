# Application metadata database. SQLite works locally.
DATABASE_URL=sqlite:///./analytics.db

# For Neon, replace DATABASE_URL with the direct connection string from its Connect dialog:
# DATABASE_URL=postgresql://neondb_owner:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-production-secret
ACCESS_TOKEN_MINUTES=1440
CORS_ALLOW_ORIGINS=http://localhost:8000
MAX_UPLOAD_MB=25

# Optional AI analyst provider
GAP=
